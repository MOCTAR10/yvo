# Copier en .env (jamais commité) et remplacer les valeurs.
# Mot de passe d'Yvo : utilisé uniquement au premier démarrage pour créer le compte.
YVO_PASSWORD=changez-moi
# Mot de passe de la base PostgreSQL (interne au docker compose).
POSTGRES_PASSWORD=changez-moi-aussi
# Port local de l'application sur le VPS (le proxy HTTPS Nginx/Caddy pointe dessus).
YVO_HTTP_PORT=8080
