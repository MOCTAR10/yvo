{
  "name": "yvo-epargne",
  "version": "4.0.4",
  "private": true,
  "description": "YVO Épargne — application hors ligne + serveur de synchronisation",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/server.js",
    "set-password": "node server/set-password.js",
    "check": "node scripts/check-syntax.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "db:start": "pg_ctl -D .pgdata -o \"-p 5442\" -l .pgdata/postgres.log start",
    "db:stop": "pg_ctl -D .pgdata stop"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
